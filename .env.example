# ==============================================================================
# HEW Groups - Environment Variables Template
# Safe to commit to GitHub.
# For Vercel: Add these keys in Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# Razorpay Publishable Key ID
RAZORPAY_KEY_ID=your_razorpay_key_id_here

# EmailJS Automation Credentials (from https://dashboard.emailjs.com/)
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here

